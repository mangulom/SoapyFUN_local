{
  "name": "soapyfun",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:api": "cd ../backend && python run.py",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
